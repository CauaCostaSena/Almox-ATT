{
  "name": "almox-mysql",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.mjs",
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/unit.test.mjs tests/service.test.mjs",
    "test:integration": "node --env-file-if-exists=.env.test --experimental-strip-types --test tests/mysql.test.mjs",
    "test:system": "node --env-file-if-exists=.env.test --experimental-strip-types --test tests/system.test.mjs",
    "test:acceptance": "node --env-file-if-exists=.env.test --experimental-strip-types --test tests/acceptance.test.mjs",
    "setup:env": "node server/init-env.mjs",
    "db:setup": "node --env-file=.env server/setup-db.mjs",
    "db:setup:test": "node --env-file=.env.test server/setup-db.mjs",
    "admin:reset": "node --env-file=.env server/reset-admin.mjs",
    "test:changes": "node --experimental-strip-types --test tests/changes-3-2.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "mysql2": "3.24.5",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
